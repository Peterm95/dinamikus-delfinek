                            <button type="button" class="tj-back" id="tj-back">← Vissza a gyerekek adataihoz</button>

                        </div>
                    </form>
                </div>

                <div class="tj-decor r"><img src="eszti karakter.png" alt="" loading="lazy"></div>
            </div>
        </div>
    </div>

       <!-- sikeres jelentkezés -->
    <div class="tj-modal" id="tj-modal" hidden role="dialog" aria-modal="true" aria-labelledby="tj-modal-title">
        <div class="tj-modal-card">
            <div class="tj-modal-icon">🎉</div>
            <h3 id="tj-modal-title">Megvan a helyetek!</h3>
            <p id="tj-m-greet"></p>
            <div class="tj-modal-info">
                <div>Jelentkezési azonosító: <strong id="tj-m-id"></strong></div>
                <div id="tj-m-kids" style="margin:6px 0;"></div>
                <div>Fizetendő összesen: <strong id="tj-m-total"></strong></div>
                <div>Foglalási előleg: <strong id="tj-m-eloleg"></strong> <span id="tj-m-eloleg-note"></span></div>
            </div>
            <p>A befizetés részleteit a visszaigazoló levélben találod. Ha bármi kérdésed van, írj nekünk bátran: <a href="mailto:dinamikus.delfinek@gmail.com">dinamikus.delfinek@gmail.com</a></p>
            <p style="font-weight:800; color:var(--tj-navy);">Várunk benneteket a táborba! 🐬<br><span style="font-weight:700; font-size:14px;">A Dinamikus Delfinek csapata</span></p>
            <button type="button" id="tj-m-ok" class="cta-btn" style="width:auto; padding:10px 40px;">Rendben</button>
        </div>
    </div>

    <!-- küldés közben -->
    <div class="tj-loading" id="tj-loading" aria-live="polite">
        <div class="tj-loading-card">
            <div class="tj-anim">
                <div class="tj-jx"><div class="tj-jy"><span>🐬</span></div></div>
                <div class="tj-water"></div>
            </div>
            <div id="tj-loading-text">Küldés…</div>
        </div>
    </div>
</section>


<script>
(function () {
    'use strict';

    // ═══════════════════ BEÁLLÍTÁSOK ═══════════════════
    var CFG = {
        // Az Apps Script webapp címe (ide kerül a tabor_jelentkezes_backend.gs-t tartalmazó projekt deploy URL-je)
        scriptURL: 'https://script.google.com/macros/s/AKfycbyD0pqzw8XT4-pZ2q3DM_Emoht71Ou9JX6It9n0NJfR-sgE7554eJ0pIJ9QGQHQOb53xA/exec',
        recaptchaKey: '6Le-gActAAAAACV802jPZ4Vp29oz_6h-323HOtKq',

        turnusok: [   // status: green | yellow | red | full  (a szerver, ha tudja, felülírja a szabad helyek alapján)
            { id: '1', nev: 'I. tábori hét',  datum: '2027. július 12–16.', status: 'green' },
            { id: '2', nev: 'II. tábori hét', datum: '2027. július 19–23.', status: 'green' }
        ],
        arAlap: 69900,        // Ft / turnus
        kuponKedv: 5000,      // Ft / turnus, az első gyermekre (kuponnal)
        testverKedv: 3000,    // Ft / turnus, ha van testvér: minden gyermekre jár (az első gyermekre csak kupon nélkül)
        elolegOsszeg: 30000,  // Ft / gyermek, a jelentkezés után fizetendő előleg
        maxGyerek: 5,
        korMin: 6, korMax: 14, taborKezdete: '2027-07-12',   // csak figyelmeztetés, nem tiltás
        pirosHatar: 5, sargaHatar: 12,                       // ennyi vagy kevesebb szabad helynél vált színt

        // 48 órás előjelentkezés: ha be van kapcsolva, a nyilvános indulásig csak érvényes hírlevél-kóddal
        // (link: ?elo=KÓD vagy ?kupon=KÓD, vagy a kód beírása a zárolt oldalon) lehet jelentkezni. A szerver is ellenőrzi.
        zarolas: false,
        nyilvanosNyil: '2027-01-20T10:00:00+01:00',
        nyilvanosSzoveg: '2027. január 20. (szerda) 10:00'
    };

    var STATUS_TXT = { green: 'Szabad helyek', yellow: 'Korlátozott számú hely', red: 'Utolsó helyek', full: 'Betelt' };
    var USZAS = [
        ['Kezdő', 'Kezdő (vízhez szoktatást igényel / fél a mélyvíztől)'],
        ['Középhaladó', 'Középhaladó (segédeszközzel vagy sekély vízben már magabiztos)'],
        ['Haladó', 'Haladó (mélyvízbiztos, több úszásnemben úszik folyamatosan)']
    ];

    // ═══════════════════ SEGÉDEK ═══════════════════
    function $(id) { return document.getElementById(id); }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function ft(n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0') + '\u00a0Ft'; }
    function fmtDate(v) { var p = String(v || '').split('-'); return p.length === 3 ? p[0] + '. ' + p[1] + '. ' + p[2] + '.' : '–'; }
    function turnusById(id) { for (var i = 0; i < CFG.turnusok.length; i++) if (CFG.turnusok[i].id === id) return CFG.turnusok[i]; return null; }
    function param(name) { try { return new URLSearchParams(location.search).get(name) || ''; } catch (e) { return ''; } }

    // <pricing>
    // Árazás – a backend (tjSzamol_) UGYANEZT a logikát futtatja; a szerver számolása a mérvadó.
    //  • az 1. gyermek: érvényes kuponnal turnusonként kuponKedv;
    //    kupon nélkül, ha van testvér, turnusonként testverKedv; egyébként alapár
    //  • a 2.+ gyermek: turnusonként testverKedv (a kupon rájuk nem vonatkozik)
    //  → egy gyermekre soha nem vonódik össze két kedvezmény
        function szamol(kids, kuponOk, cfg) {
        var out = { kids: [], alap: 0, kedv: 0, vegosszeg: 0, eloleg: 0, turnusDb: 0, turnusEgyedi: 0 };
        var van2 = kids.length > 1, egyedi = {};
        kids.forEach(function (k, i) {
            var n = k.turnusok.length, alap = n * cfg.arAlap, kedv = 0, tipus = '', eloleg = 0;
            if (n > 0) {
                if (i === 0 && kuponOk) { tipus = 'kupon'; kedv = n * cfg.kuponKedv; }
                else if (i > 0 || van2) { tipus = 'testver'; kedv = n * cfg.testverKedv; }
                eloleg = Math.min(cfg.elolegOsszeg, alap - kedv);   // gyermekenként, de a díjánál nem több
            }
            k.turnusok.forEach(function (id) { egyedi[id] = 1; });
            out.kids.push({ n: n, alap: alap, kedv: kedv, tipus: tipus, fizetendo: alap - kedv, eloleg: eloleg });
            out.alap += alap; out.kedv += kedv; out.turnusDb += n; out.eloleg += eloleg;
        });
        out.vegosszeg = out.alap - out.kedv;
        out.turnusEgyedi = Object.keys(egyedi).length;
        return out;
    }
    // </pricing>
    // kuponkód: a szülő csak a 4 karaktert írja, a DINI- előtagot mi tesszük hozzá
    function kuponNorm(v) {
        v = String(v || '').toUpperCase().replace(/\s+/g, '').replace(/^DINI-?/, '');
        return v.replace(/[^A-Z0-9]/g, '').slice(0, 4);
    }
    function kuponTeljes(v) { var k = kuponNorm(v); return k ? 'DINI-' + k : ''; }
    
    // ═══════════════════ ÁLLAPOT ═══════════════════
    var S = { kids: [], nextId: 1, kupon: { kod: '', st: 'none', msg: '' }, status: {}, step: 1, elo: kuponTeljes(param('elo') || param('kupon')) };
    var lastTotal = '';

    function newKid(from) {
        var t = [];
        if (from) from.turnusok.forEach(function (id) { if ((S.status[id] || {}).status !== 'full') t.push(id); });
        return { id: S.nextId++, nev: '', szul: '', uszas: '', turnusok: t };
    }

    // ═══════════════════ GYERMEK-KÁRTYÁK ═══════════════════
    function kidHtml(k, i) {
        var opts = CFG.turnusok.map(function (t) {
            var st = (S.status[t.id] || {}).status || t.status;
            var sel = k.turnusok.indexOf(t.id) >= 0;
            return '<label class="tj-opt' + (sel ? ' sel' : '') + '" data-status="' + st + '">' +
                '<input type="checkbox" data-f="turnus" value="' + esc(t.id) + '"' + (sel ? ' checked' : '') + (st === 'full' ? ' disabled' : '') + '>' +
                '<span class="tj-opt-main"><span class="tj-opt-day">' + esc(t.nev) + '</span><span class="tj-opt-time">' + esc(t.datum) + '</span></span>' +
                '<span class="tj-opt-st">' + STATUS_TXT[st] + '</span></label>';
        }).join('');
        var uszas = '<option value="">Válassz egy szintet</option>' + USZAS.map(function (u) {
            return '<option value="' + u[0] + '"' + (k.uszas === u[0] ? ' selected' : '') + '>' + u[1] + '</option>';
        }).join('');
        var tag = i === 0 ? '' : '<span class="tj-child-tag sib">testvérkedvezmény</span>';
        var pre = 'tj-' + k.id + '-';
        return '<div class="tj-child" data-id="' + k.id + '">' +
            '<div class="tj-child-h"><div class="tj-child-t"><span class="tj-child-n">' + (i + 1) + '</span>Gyermek ' + tag + '</div>' +
            (i > 0 ? '<button type="button" class="tj-child-del" data-del="1">Törlés ✕</button>' : '') + '</div>' +
            '<div class="tj-group" data-g="nev"><label class="tj-label" for="' + pre + 'nev">Gyermek teljes neve</label>' +
            '<input type="text" id="' + pre + 'nev" class="tj-input" data-f="nev" placeholder="Pl. Kovács Bence" maxlength="100" value="' + esc(k.nev) + '"><span class="tj-err"></span></div>' +
            '<div class="tj-group" data-g="szul"><label class="tj-label" for="' + pre + 'szul">Születési idő</label>' +
            '<input type="date" id="' + pre + 'szul" class="tj-input" data-f="szul" value="' + esc(k.szul) + '"><span class="tj-err"></span><div class="tj-hint" data-hint="1"></div></div>' +
            '<div class="tj-group" data-g="uszas"><label class="tj-label" for="' + pre + 'uszas">Jelenlegi úszástudás</label>' +
            '<select id="' + pre + 'uszas" class="tj-input" data-f="uszas">' + uszas + '</select><span class="tj-err"></span></div>' +
            '<div class="tj-group" data-g="turnusok"><label class="tj-label">Melyik turnus(ok)ra jön?</label><div class="tj-opts">' + opts + '</div><span class="tj-err"></span></div>' +
            '</div>';
    }

    function renderKids() {
        $('tj-children').innerHTML = S.kids.map(kidHtml).join('');
        S.kids.forEach(function (k) { var el = kidEl(k.id); if (el && k.szul) ageHint(el, k.szul); });
        var full = S.kids.length >= CFG.maxGyerek;
        $('tj-add').disabled = full;
        $('tj-add-sub').textContent = full ? 'Egy jelentkezéssel legfeljebb ' + CFG.maxGyerek + ' gyermek adható meg' : 'Testvérkedvezmény: −' + ft(CFG.testverKedv) + ' turnusonként minden gyermekre';
    }
    function kidEl(id) { return document.querySelector('.tj-child[data-id="' + id + '"]'); }
    function kidOf(el) { var c = el.closest('.tj-child'); if (!c) return null; var id = Number(c.getAttribute('data-id')); for (var i = 0; i < S.kids.length; i++) if (S.kids[i].id === id) return S.kids[i]; return null; }

    function validDate(v) {
        if (!/^\d{4}-\d{2}-\d{2}$/.test(v || '')) return false;
        var p = v.split('-'), d = new Date(+p[0], +p[1] - 1, +p[2]);
        return d.getFullYear() === +p[0] && d.getMonth() === +p[1] - 1 && d.getDate() === +p[2] && d <= new Date() && +p[0] >= 2000;
    }
    function korTabor(v) {
        var p = v.split('-'), b = new Date(+p[0], +p[1] - 1, +p[2]), t = new Date(CFG.taborKezdete);
        var a = t.getFullYear() - b.getFullYear(), m = t.getMonth() - b.getMonth();
        if (m < 0 || (m === 0 && t.getDate() < b.getDate())) a--;
        return a;
    }
    function ageHint(card, v) {
        var h = card.querySelector('[data-hint]');
        if (!h) return;
        if (!validDate(v)) { h.classList.remove('show'); return; }
        var a = korTabor(v);
        if (a < CFG.korMin || a > CFG.korMax) {
            h.textContent = 'A tábor ' + CFG.korMin + '–' + CFG.korMax + ' éves gyerekeknek szól (a gyermek a tábor kezdetén ' + a + ' éves lesz). Ha szeretnétek jelentkezni, írj nekünk, és megnézzük.';
            h.classList.add('show');
        } else h.classList.remove('show');
    }
    function clearErr(group) { if (group) group.classList.remove('tj-invalid'); }

    // ═══════════════════ ÖSSZEGZÉS ═══════════════════
    function sumHtml(res) {
        if (!res.turnusDb) return '<div class="tj-sum-empty">🐬 Válassz turnust, és itt azonnal látod a pontos díjat.</div>';
        var h = '<div class="tj-s-head"><span class="tj-s-head-l"><span class="tj-s-icon">🏊</span><span class="tj-s-title">Összegzés</span></span><span class="tj-s-total">' + ft(res.vegosszeg) + '</span></div>';
        S.kids.forEach(function (k, i) {
            var r = res.kids[i];
            var nev = esc(k.nev.trim() || (i + 1) + '. gyermek');
            if (!r.n) { h += '<div class="tj-s-kid"><div class="tj-s-kid-h"><span>' + nev + '</span><span>–</span></div><div class="tj-s-turnus">Még nincs turnus kiválasztva</div></div>'; return; }
            h += '<div class="tj-s-kid"><div class="tj-s-kid-h"><span>' + nev + '</span><span>' + ft(r.fizetendo) + '</span></div>';
            if (validDate(k.szul)) h += '<div class="tj-s-turnus">Születési idő: ' + fmtDate(k.szul) + '</div>';
            h += '<div class="tj-s-turnus">' + k.turnusok.map(function (id) { var t = turnusById(id); return esc(t.nev + ' (' + t.datum + ')'); }).join('<br>') + '</div>';
            h += '<div class="tj-s-row"><span>' + r.n + ' × ' + ft(CFG.arAlap) + '</span><strong>' + ft(r.alap) + '</strong></div>';
            if (r.kedv) {
                h += '<div class="tj-s-row disc"><span>' + (r.tipus === 'kupon' ? 'Kuponkedvezmény' : 'Testvérkedvezmény') + ' (' + r.n + ' × ' + ft(r.tipus === 'kupon' ? CFG.kuponKedv : CFG.testverKedv) + ')</span><strong>−' + ft(r.kedv) + '</strong></div>';
            }
            h += '</div>';
        });
        h += '<div class="tj-s-totals">';
        if (res.kedv) {
            h += '<div class="tj-s-row strike"><span>Alapár összesen</span><strong>' + ft(res.alap) + '</strong></div>';
            h += '<div class="tj-s-row disc"><span>Kedvezmények összesen</span><strong>−' + ft(res.kedv) + '</strong></div>';
        }
        h += '<div class="tj-s-row"><span><strong>Fizetendő összesen</strong></span><strong>' + ft(res.vegosszeg) + '</strong></div>';
                var elGy = res.kids.filter(function (r) { return r.n > 0; }).length;
        h += '<div class="tj-s-row dep"><span>Foglalási előleg (' + elGy + ' gyermek × ' + ft(CFG.elolegOsszeg) + ')</span><strong>' + ft(res.eloleg) + '</strong></div></div>';
        if ($('tj-kupon').value.trim() && S.kupon.st !== 'ok') h += '<p class="tj-s-warn">A kuponkód még nincs beváltva: nyomd meg a „Beváltom” gombot, hogy beleszámítsuk.</p>';
                h += '<p class="tj-s-note">A hely biztosításához <strong>gyermekenként ' + ft(CFG.elolegOsszeg) + ' előleg</strong> szükséges. A fizetés részleteit a visszaigazoló e-mailben küldjük. Egy gyermekre egyszerre csak egy kedvezmény jár. A végső összeget a jelentkezés elküldésekor a szerver is ellenőrzi.</p>';
        return h;
    }

    function renderSummary() {
        var res = szamol(S.kids, S.kupon.st === 'ok', CFG);
        var html = sumHtml(res);
        $('tj-sum-1').innerHTML = html;
        $('tj-sum-2').innerHTML = html;
        var total = res.turnusDb ? ft(res.vegosszeg) : '—';
        var bt = $('tj-bar-total');
        bt.textContent = total;
        $('tj-bar-sub').textContent = res.turnusDb ? S.kids.length + ' gyermek · ' + res.turnusEgyedi + ' turnus' + (res.kedv ? ' · −' + ft(res.kedv) : '') : 'Válassz turnust';
        if (total !== lastTotal && lastTotal) { bt.classList.remove('tj-bump'); void bt.offsetWidth; bt.classList.add('tj-bump'); }
        lastTotal = total;
        return res;
    }

    // ═══════════════════ SZERVER-KAPCSOLAT ═══════════════════
    function api(action, data) {
        var fd = new FormData();
        fd.append('formTipus', 'tabor');
        fd.append('action', action);
        Object.keys(data || {}).forEach(function (k) { fd.append(k, data[k]); });
        return fetch(CFG.scriptURL, { method: 'POST', body: fd }).then(function (r) { return r.json(); });
    }
    function getToken() {
        return new Promise(function (res) {
            if (!window.grecaptcha || !window.grecaptcha.ready) { res(''); return; }
            window.grecaptcha.ready(function () {
                window.grecaptcha.execute(CFG.recaptchaKey, { action: 'submit' }).then(res).catch(function () { res(''); });
            });
        });
    }

    // szabad helyek → színes jelölők
    function loadAllapot() {
        api('allapot', {}).then(function (r) {
            if (!r || !r.turnusok) return;
            CFG.turnusok.forEach(function (t) {
                var x = r.turnusok[t.id];
                if (!x || x.szabad === null || x.szabad === undefined) return;
                var st = x.szabad <= 0 ? 'full' : x.szabad <= CFG.pirosHatar ? 'red' : x.szabad <= CFG.sargaHatar ? 'yellow' : 'green';
                S.status[t.id] = { status: st, szabad: x.szabad };
            });
            S.kids.forEach(function (k) { k.turnusok = k.turnusok.filter(function (id) { return (S.status[id] || {}).status !== 'full'; }); });
            renderKids(); renderSummary();
        }).catch(function () { /* a statikus jelölők maradnak */ });
    }

    // ═══════════════════ KUPONKÓD ═══════════════════
    var KUPON_ALAP = 'A hírlevélben kapott kódot itt tudod beváltani.';
    function renderCoupon() {
        var box = $('tj-coupon'), msg = $('tj-kupon-msg'), btn = $('tj-kupon-btn');
        box.classList.toggle('ok', S.kupon.st === 'ok');
        box.classList.toggle('bad', S.kupon.st === 'hiba');
        msg.textContent = S.kupon.msg || KUPON_ALAP;
        btn.disabled = S.kupon.st === 'checking';
        btn.textContent = S.kupon.st === 'checking' ? 'Ellenőrzés…' : S.kupon.st === 'ok' ? 'Törlés' : 'Beváltom';
    }
    function setCoupon(st, kod, msg) { S.kupon = { kod: kod || '', st: st, msg: msg || '' }; renderCoupon(); renderSummary(); }

    function checkCoupon() {
        var kod = $('tj-kupon').value.trim().toUpperCase();
        if (!kod) { setCoupon('none'); return Promise.resolve(true); }
        setCoupon('checking', kod, 'Ellenőrizzük a kódot…');
        return api('kupon', { kupon: kod }).then(function (r) {
            if (r && r.valid) {
                setCoupon('ok', kod, '✓ Érvényes kuponkód!');
                return true;
            }
            setCoupon('hiba', kod, (r && r.message) || 'Ez a kuponkód nem érvényes. Ha nincs kódod, töröld a mezőt.');
            return false;
        }).catch(function () {
            setCoupon('hiba', kod, 'Most nem sikerült ellenőrizni a kódot. Próbáld újra egy perc múlva.');
            return false;
        });
    }

    // ═══════════════════ LÉPÉSEK ═══════════════════
    function goTo(n, noScroll) {
        S.step = n;
        $('tj-step-1').classList.toggle('active', n === 1);
        $('tj-step-2').classList.toggle('active', n === 2);
        document.querySelectorAll('.tj-pstep').forEach(function (p) { p.classList.toggle('active', Number(p.getAttribute('data-s')) <= n); });
        $('tj-pline').classList.toggle('on', n === 2);
        renderSummary();
        if (!noScroll) $('tj-box').scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(function () {
            var t = n === 1 ? document.querySelector('#tj-children input[data-f="nev"]') : $('tj-szulo');
            if (t) t.focus({ preventScroll: true });
        }, 450);
    }

    function validateStep1() {
        var firstBad = null;
        S.kids.forEach(function (k) {
            var card = kidEl(k.id), errs = {};
            if (k.nev.trim().length < 2) errs.nev = 'Add meg a gyermek teljes nevét.';
            if (!validDate(k.szul)) errs.szul = 'Add meg a születési időt (érvényes, múltbeli dátum).';
            if (!k.uszas) errs.uszas = 'Válaszd ki a gyermek úszástudását.';
            if (!k.turnusok.length) errs.turnusok = 'Válassz legalább egy turnust.';
            ['nev', 'szul', 'uszas', 'turnusok'].forEach(function (g) {
                var grp = card.querySelector('[data-g="' + g + '"]');
                grp.classList.toggle('tj-invalid', !!errs[g]);
                grp.querySelector('.tj-err').textContent = errs[g] || '';
                if (errs[g] && !firstBad) firstBad = grp;
            });
        });
        if (firstBad) {
            firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' });
            var f = firstBad.querySelector('input:not([type=checkbox]), select');
            if (f) setTimeout(function () { f.focus({ preventScroll: true }); }, 350);
        }
        return !firstBad;
    }

    // ═══════════════════ KÜLDÉS ═══════════════════
    function showLoading(t) { $('tj-loading-text').textContent = t || 'Küldés…'; $('tj-loading').classList.add('active'); }
    function hideLoading() { $('tj-loading').classList.remove('active'); }
    function showError(msg) { var e = $('tj-error'); e.textContent = msg; e.classList.add('show'); e.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

    function submitForm(ev) {
        ev.preventDefault();
        $('tj-error').classList.remove('show');
        if (!validateStep1()) { goTo(1); return; }
        var form = $('tj-form');
        if (!form.checkValidity()) { form.reportValidity(); return; }

        var payload = {
            kupon: S.kupon.st === 'ok' ? S.kupon.kod : '',
            elo: S.elo,
            gyerekek: S.kids.map(function (k) { return { nev: k.nev.trim(), szul: k.szul, uszas: k.uszas, turnusok: k.turnusok }; }),
            szulo: {
                nev: $('tj-szulo').value.trim(), email: $('tj-email').value.trim(), telefon: $('tj-tel').value.trim(),
                lakcim: [$('tj-irsz').value.trim(), $('tj-varos').value.trim()].filter(Boolean).join(' ') + ', ' + $('tj-utca').value.trim()
            },
            megjegyzes: $('tj-megj').value.trim(),
            honnan: $('tj-honnan').value
        };

        var btn = $('tj-submit'), original = btn.textContent;
        btn.disabled = true; btn.textContent = 'Biztonsági ellenőrzés és küldés…';
        showLoading('Jelentkezés küldése…');
        function reset() { hideLoading(); btn.disabled = false; btn.textContent = original; }

        getToken().then(function (token) {
            return api('jelentkezes', { payload: JSON.stringify(payload), recaptcha_token: token, nyilatkozat: 'Elfogadva' });
        }).then(function (r) {
            reset();
            if (r && r.result === 'success') { showSuccess(r); return; }
            var err = new Error((r && r.message) || 'Szerveroldali hiba történt.');
            err.code = r && r.code;
            throw err;
        }).catch(function (err) {
            reset();
            if (err && err.code === 'kupon') {          // a kupon időközben érvénytelenné vált
                setCoupon('hiba', 'DINI-' + kuponNorm($('tj-kupon').value), err.message);
                goTo(1);
                return;
            }
            if (err && err.code === 'hely') loadAllapot();
            showError(err && err.code ? err.message : 'Nem sikerült elküldeni a jelentkezést. Ellenőrizd az internetkapcsolatot, és próbáld újra. Ha többször nem megy, írj nekünk: dinamikus.delfinek@gmail.com');
        });
    }

        function showSuccess(r) {
        function setTxt(id, t) { var e = $(id); if (e) e.textContent = t; }
        var calc = szamol(S.kids, S.kupon.st === 'ok', CFG);
        var szulo = $('tj-szulo') ? $('tj-szulo').value.trim() : '';
        var email = $('tj-email') ? $('tj-email').value.trim() : '';
        var db = (r.gyerekek && r.gyerekek.length) || S.kids.length;
        var total = r.osszesen != null ? r.osszesen : calc.vegosszeg;
        var elo = r.eloleg != null ? r.eloleg : calc.eloleg;

        setTxt('tj-m-greet',
            (szulo ? 'Kedves ' + szulo + '! ' : '') +
            'Megkaptuk a jelentkezést, és nagyon örülünk, hogy ' + (db > 1 ? 'a gyerekekkel' : 'a gyermekeddel') + ' együtt velünk töltitek a nyarat. ' +
            'A visszaigazoló levelet ' + (email ? 'a ' + email + ' címre' : 'a megadott címre') + ' küldtük. Ha pár percen belül nem érkezik meg, nézd meg a spam mappát is.');
        setTxt('tj-m-id', r.azonosito || '');
        setTxt('tj-m-total', ft(total));
        setTxt('tj-m-eloleg', ft(elo));
        setTxt('tj-m-eloleg-note', db > 1 ? '(gyermekenként ' + ft(CFG.elolegOsszeg) + ')' : '');

        var kidsEl = $('tj-m-kids');
        if (kidsEl) kidsEl.innerHTML = (r.gyerekek || []).map(function (g) {
            return '• ' + esc(g.nev) + ' – ' + esc(g.turnusok) + ' (' + ft(g.fizetendo) + ')';
        }).join('<br>');

        $('tj-modal').hidden = false;
        var ok = $('tj-m-ok'); if (ok) ok.focus();
    }

    function resetAll() {
        $('tj-modal').hidden = true;
        $('tj-form').reset();
        S.nextId = 1; S.kids = [newKid()];
        S.kupon = { kod: '', st: 'none', msg: '' };
        renderKids(); renderCoupon(); lastTotal = ''; renderSummary();
        goTo(1);
        loadAllapot();
    }

    // ═══════════════════ ZÁROLÁS / ELŐJELENTKEZÉS ═══════════════════
    function initGate() {
        var open = new Date(CFG.nyilvanosNyil).getTime();
        if (!CFG.zarolas || Date.now() >= open) return;

        $('tj-wrap').hidden = true; $('tj-lock').hidden = false; $('tj-notice').hidden = true;
        $('tj-open-text').textContent = CFG.nyilvanosSzoveg;

        function unlock(early) {
            $('tj-lock').hidden = true; $('tj-wrap').hidden = false; $('tj-notice').hidden = false;
            if (early) {
                var n = $('tj-notice');
                n.classList.add('star');
                n.textContent = '⭐ Előjelentkezés: hírlevél-feliratkozóként elsőként jelentkezhetsz, 48 órával a nyilvános indulás előtt.';
            }
        }
        function tryCode(kod) {
            var msg = $('tj-elo-msg'), btn = $('tj-elo-btn');
            kod = kuponTeljes(kod);
            if (!kod) { msg.textContent = 'Add meg a hírlevélben kapott kódot.'; return; }
            btn.disabled = true; msg.textContent = 'Ellenőrizzük…';
            api('elo', { elo: kod }).then(function (r) {
                btn.disabled = false;
                if (r && r.valid) { S.elo = kod; unlock(true); }
                else { S.elo = ''; msg.textContent = (r && r.message) || 'Ez a kód nem érvényes.'; }
            }).catch(function () { btn.disabled = false; msg.textContent = 'Most nem sikerült ellenőrizni, próbáld újra.'; });
        }
        $('tj-elo-btn').addEventListener('click', function () { tryCode($('tj-elo').value); });
        $('tj-elo').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); tryCode(this.value); } });
        if (S.elo) tryCode(S.elo);   // a hírlevél-linkről érkezők automatikusan belépnek

        function tick() {
            var d = Math.max(0, open - Date.now());
            if (d <= 0) { if ($('tj-wrap').hidden) unlock(false); return; }
            var v = { d: Math.floor(d / 864e5), h: Math.floor(d % 864e5 / 36e5), m: Math.floor(d % 36e5 / 6e4), s: Math.floor(d % 6e4 / 1e3) };
            Object.keys(v).forEach(function (u) { $('tj-count').querySelector('[data-u="' + u + '"]').textContent = v[u]; });
            setTimeout(tick, 1000);
        }
        tick();
    }

    // ═══════════════════ INDÍTÁS ═══════════════════
    document.addEventListener('DOMContentLoaded', function () {
        if (!$('tj-form')) return;

        S.kids = [newKid()];
        renderKids(); renderCoupon(); renderSummary(); initGate();

        // gyermek-kártyák eseményei (delegálva, mert újrarajzoljuk őket)
        var kidsEl = $('tj-children');
        kidsEl.addEventListener('input', function (e) {
            var f = e.target.getAttribute('data-f');
            if (!f || f === 'turnus') return;
            var k = kidOf(e.target); if (!k) return;
            k[f] = e.target.value;
            clearErr(e.target.closest('.tj-group'));
            if (f === 'szul') ageHint(e.target.closest('.tj-child'), k.szul);
            renderSummary();
        });
        kidsEl.addEventListener('change', function (e) {
            var t = e.target, f = t.getAttribute('data-f'), k = kidOf(t);
            if (!k || !f) return;
            if (f === 'turnus') {
                var card = t.closest('.tj-child');
                k.turnusok = Array.prototype.map.call(card.querySelectorAll('input[data-f="turnus"]:checked'), function (c) { return c.value; });
                t.closest('.tj-opt').classList.toggle('sel', t.checked);
                clearErr(t.closest('.tj-group'));
            } else { k[f] = t.value; clearErr(t.closest('.tj-group')); }
            renderSummary();
        });
        kidsEl.addEventListener('click', function (e) {
            if (!e.target.closest('[data-del]')) return;
            var k = kidOf(e.target); if (!k) return;
            S.kids = S.kids.filter(function (x) { return x !== k; });
            renderKids(); renderSummary();
        });

        $('tj-add').addEventListener('click', function () {
            if (S.kids.length >= CFG.maxGyerek) return;
            var k = newKid(S.kids[0]);
            S.kids.push(k);
            renderKids(); renderSummary();
            var card = kidEl(k.id);
            if (card) { card.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(function () { var i = card.querySelector('input[data-f="nev"]'); if (i) i.focus({ preventScroll: true }); }, 400); }
        });

        // kupon
        var kInput = $('tj-kupon');
        $('tj-kupon-btn').addEventListener('click', function () {
            if (S.kupon.st === 'ok') { kInput.value = ''; setCoupon('none'); return; }
            checkCoupon();
        });
        kInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); checkCoupon(); } });
        kInput.addEventListener('input', function () {
            kInput.value = kuponNorm(kInput.value);
            if (S.kupon.st === 'ok' || S.kupon.st === 'hiba') setCoupon('none'); else renderSummary();
        });
        var pre = param('kupon');
                if (pre) { kInput.value = kuponNorm(pre); checkCoupon(); }

        // lépések
        $('tj-next').addEventListener('click', function () {
            if (!validateStep1()) return;
            var kod = kInput.value.trim();
            var p = (kod && S.kupon.st !== 'ok') ? checkCoupon() : Promise.resolve(true);
            p.then(function (ok) {
                if (!ok) { $('tj-coupon').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
                goTo(2);
            });
        });
        $('tj-back').addEventListener('click', function () { goTo(1); });

        // irányítószám → település
        $('tj-irsz').addEventListener('blur', function () {
            var irsz = this.value.trim();
            if (!/^\d{4}$/.test(irsz)) return;
            fetch('https://api.zippopotam.us/HU/' + irsz)
                .then(function (r) { if (!r.ok) throw 0; return r.json(); })
                .then(function (d) { var p = d && d.places && d.places[0] && d.places[0]['place name']; if (p && !$('tj-varos').value) $('tj-varos').value = p; })
                .catch(function () { /* kézzel kitölthető */ });
        });

        $('tj-form').addEventListener('submit', submitForm);
        $('tj-m-ok').addEventListener('click', resetAll);

        loadAllapot();

        // belépő animáció
        var box = $('tj-box');
        if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (en, ob) { if (en[0].isIntersecting) { box.classList.add('in'); ob.disconnect(); } }, { threshold: 0.08 }).observe(box);
        } else box.classList.add('in');
    });
})();
</script>






















