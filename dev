    <script>
        function switchDay(dayId) {
            const panels = document.querySelectorAll('.day-panel');
            panels.forEach(panel => {
                panel.classList.remove('active');
                panel.style.display = 'none';
            });
            
            const tabs = document.querySelectorAll('.tab-btn');
            tabs.forEach(tab => {
                tab.classList.remove('active');
            });
            
            const activePanel = document.getElementById(dayId);
            activePanel.style.display = 'block';
            
            setTimeout(() => {
                activePanel.classList.add('active');
            }, 20);
            
            event.currentTarget.classList.add('active');
        }

        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('camp-registration-form');
            const submitBtn = document.getElementById('submit-camp-btn');
            const hiddenTurnusInput = document.getElementById('hidden-turnusok-input');
            const childNameInput = document.getElementById('gyermekNeveInput');
            
            const customModal = document.getElementById('custom-modal');
            const registeredChildNameSpan = document.getElementById('registered-child-name');
            const modalOkBtn = document.getElementById('modal-ok-btn');

            const scriptURL = 'https://script.google.com/macros/s/AKfycbyD0pqzw8XT4-pZ2q3DM_Emoht71Ou9JX6It9n0NJfR-sgE7554eJ0pIJ9QGQHQOb53xA/exec';

            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const checkedBoxes = document.querySelectorAll('.camp-turnus-cb:checked');
                    if(checkedBoxes.length === 0) {
                        alert('Kérjük, válasszon ki legalább egy tábori időpontot!');
                        return false;
                    }
                    
                    const selectedTurnusok = Array.from(checkedBoxes).map(cb => cb.value).join(', ');
                    if(hiddenTurnusInput) hiddenTurnusInput.value = selectedTurnusok;

                    if(submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerText = 'Küldés folyamatban...';
                    }

                    const gyermekNeve = childNameInput ? childNameInput.value : 'a gyermek';
                    const formData = new FormData(form);
                    
                    fetch(scriptURL, {
                        method: 'POST',
                        body: formData,
                        mode: 'no-cors'
                    })
                    .then(() => {
                        if(submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerText = 'Hivatalos tábori jelentkezés elküldése';
                        }

                        if(registeredChildNameSpan) registeredChildNameSpan.innerText = gyermekNeve;
                        if(customModal) customModal.style.display = 'flex';
                    })
                    .catch(error => {
                        console.error('Hiba!', error);
                        if(submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerText = 'Hivatalos tábori jelentkezés elküldése';
                        }
                        alert('Hiba történt a jelentkezés küldése közben. Kérjük, próbálja meg újra!');
                    });
                });
            }

            if(modalOkBtn) {
                modalOkBtn.addEventListener('click', function() {
                    if(customModal) customModal.style.display = 'none';
                    if(form) form.reset();
                    
                    const checkedBoxes = document.querySelectorAll('.camp-turnus-cb:checked');
                    checkedBoxes.forEach(cb => cb.checked = false);
                    if(hiddenTurnusInput) hiddenTurnusInput.value = '';

                    if(form) form.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            }
        });
		// Univerzális függvény, amivel bármilyen HTML oldalt be tudsz tölteni a felugró ablakba
function openPolicyInModal(htmlPageUrl) {
    const modal = document.getElementById('universal-policy-modal');
    const titleZone = document.getElementById('policy-modal-title');
    const bodyZone = document.getElementById('policy-modal-body');

    if (!modal || !titleZone || !bodyZone) return;

    // Alaphelyzetbe állítás a betöltésig
    titleZone.innerText = "Betöltés...";
    bodyZone.innerHTML = '<p style="text-align: center; color: #64748b; padding: 20px;">Dokumentum beolvasása...</p>';
    modal.style.display = 'flex';

    // Fájl tartalmának lekérése élőben
    fetch(htmlPageUrl)
        .then(response => {
            if (!response.ok) throw new Error('Nem sikerült betölteni a fájlt.');
            return response.text();
        })
        .then(htmlText => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(htmlText, 'text/html');
            
            // Kinyerjük a címet a H1-ből, vagy ha nincs, kap egy alapértelmezettet
            const pageTitle = doc.querySelector('h1') ? doc.querySelector('h1').innerText : 'Tájékoztató';
            
            // Megtisztítjuk a külső fájl tartalmát (levágjuk a felesleges gombokat, H1-et)
            if(doc.querySelector('h1')) doc.querySelector('h1').remove();
            if(doc.querySelector('.back-btn-wrap')) doc.querySelector('.back-btn-wrap').remove();
            if(doc.querySelector('.meta-info')) doc.querySelector('.meta-info').remove();
            
            // Kivesszük a belső szövegdobozt, vagy a sima body-t
            const cleanContent = doc.querySelector('.policy-container') ? doc.querySelector('.policy-container').innerHTML : doc.body.innerHTML;

            // Betesszük a felugró ablakba
            titleZone.innerText = pageTitle;
            bodyZone.innerHTML = cleanContent;
        })
        .catch(error => {
            console.error(error);
            titleZone.innerText = "Hiba történt";
            bodyZone.innerHTML = '<p style="color: #ef4444; text-align: center;">A dokumentum jelenleg nem érhető el. Kérjük, próbálja meg később!</p>';
        });
}

